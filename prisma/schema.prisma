datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String?           @unique
  emailVerified    DateTime?
  image            String?
  password         String?           // Hashed password for credentials login
  streak           Int               @default(0)
  xp               Int               @default(0)
  lastActiveDate   DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  accounts         Account[]
  sessions         Session[]
  vocabularies     Vocabulary[]
  corrections      Correction[]
  practiceSessions PracticeSession[]
  progressRecords  Progress[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vocabulary {
  id             String   @id @default(cuid())
  userId         String
  word           String
  banglaMeaning  String
  pronunciation  String?
  exampleSentence String?
  learned        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Correction {
  id            String   @id @default(cuid())
  userId        String
  originalText  String
  correctedText String
  explanation   String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PracticeSession {
  id           String   @id @default(cuid())
  userId       String
  topic        String
  prompt       String
  userResponse String
  aiFeedback   String
  score        Int?     // For IELTS bands (e.g. out of 9) or general rating
  type         String   // "DAILY", "IELTS", "FREE_WRITING"
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyChallenge {
  id          String   @id @default(cuid())
  date        String   @unique // YYYY-MM-DD
  topic       String
  prompt      String
  type        String   // "GRAMMAR", "VOCABULARY", "IELTS"
  difficulty  String   // "BEGINNER", "INTERMEDIATE", "ADVANCED"
}

model Progress {
  id                  String   @id @default(cuid())
  userId              String
  date                String   // YYYY-MM-DD
  lessonsCompleted    Int      @default(0)
  vocabularyCount     Int      @default(0)
  currentStreak       Int      @default(0)
  xpEarned            Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
